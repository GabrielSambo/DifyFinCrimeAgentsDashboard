# KnowYourCustomer (KYB) API credentials — SANDBOX / demo tenant.
# Copy this file to .env and fill in the secret, then run the explorer.
#   cp .env.example .env
# The script auto-loads .env (which is git-ignored, so your secret is never committed).

GIBRALTAR_KYC_CLIENT_ID="sbx_3q3cbWJKPpBL"
GIBRALTAR_KYC_CLIENT_SECRET="<paste-your-sandbox-client-secret-here>"

# Optional overrides
KYC_BASE="https://api.knowyourcustomer.dev"
KYC_SCOPE="PublicApi"
KYC_TIMEOUT="20"
